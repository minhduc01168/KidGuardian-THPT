<?xml version="1.0" encoding="utf-8"?>
<!-- BUG-2 FIX: Native overlay chặn app bị hết giờ — hiển thị từ WindowManager
     trong AccessibilityService, độc lập với Flutter UI -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F01A1A2E"
    android:padding="32dp">

    <TextView
        android:id="@+id/lock_icon_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔒"
        android:textSize="72sp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đã hết thời gian sử dụng"
        android:textColor="#FFFFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/app_name_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFBBBBBB"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hãy nghỉ ngơi hoặc xin phép phụ huynh để sử dụng thêm"
        android:textColor="#FFAAAAAA"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mở KidGuardian để xin thêm thời gian"
        android:textColor="#FF7C9FF0"
        android:textSize="14sp"
        android:textStyle="italic"/>

</LinearLayout>
