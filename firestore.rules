rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow authenticated users to read/write their own user document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow authenticated users to read/write families they belong to
    match /families/{familyId} {
      allow read, write: if request.auth != null;
    }
    
    // Allow authenticated users to read/write usage logs
    match /usage_logs/{logId} {
      allow read, write: if request.auth != null;
    }
    
    // Allow authenticated users to read/write daily summaries
    match /daily_summaries/{summaryId} {
      allow read, write: if request.auth != null;
    }
    
    // Allow authenticated users to read/write alerts
    match /alerts/{alertId} {
      allow read, write: if request.auth != null;
    }
    
    // Allow authenticated users to read/write time requests
    match /time_requests/{requestId} {
      allow read, write: if request.auth != null;
    }
    
    // Allow authenticated users to read/write settings
    match /settings/{settingId} {
      allow read, write: if request.auth != null;
    }
    
    // Allow authenticated users to read/write smart lock settings
    match /smart_lock_settings/{settingId} {
      allow read, write: if request.auth != null;
    }
    
    // Allow authenticated users to read/write monitored apps
    match /monitored_apps/{appId} {
      allow read, write: if request.auth != null;
    }
    
    // Allow authenticated users to read/write blocked apps
    match /blocked_apps/{appId} {
      allow read, write: if request.auth != null;
    }
    
    // Allow authenticated users to read/write emergency logs
    match /emergency_logs/{logId} {
      allow read, write: if request.auth != null;
    }
    
    // Allow authenticated users to read/write help content
    match /help/{helpId} {
      allow read: if request.auth != null;
    }
    
    // Default rule - deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
